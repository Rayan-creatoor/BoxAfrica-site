# Clé API Anthropic — https://console.anthropic.com/settings/keys
# Ne jamais commiter la vraie valeur.
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici

# Port du serveur de chat
PORT=8787

# Origine(s) autorisées à appeler cette API (séparées par des virgules si plusieurs).
# En dev : l'URL du serveur Vite. En prod : le domaine réel du site.
ALLOWED_ORIGIN=http://localhost:5173
